# Shared secret the server expects in the X-API-Key header.
SERVER_API_KEY=change-me-to-a-long-random-string

# OAuth 1.0a user-context credentials from your X developer app
# (Keys and tokens → API Key and Secret + Access Token and Secret).
# The access token must be issued with Read and Write permissions.
X_API_KEY=your-api-key
X_API_SECRET=your-api-secret
X_ACCESS_TOKEN=your-access-token
X_ACCESS_TOKEN_SECRET=your-access-token-secret

# Optional alternative to OAuth 1.0a: an OAuth 2.0 user access token
# with tweet.write. Used only if the OAuth 1.0a variables above are unset.
# X_OAUTH2_ACCESS_TOKEN=your-oauth2-user-access-token

# Safety
MAX_POSTS_PER_DAY=10
TIMEZONE=Europe/Paris

# Where published.jsonl and usage.json are stored (default: ./data)
# DATA_DIR=./data
